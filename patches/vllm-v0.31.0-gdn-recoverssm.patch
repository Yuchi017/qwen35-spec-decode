+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""RecoverSSM speculative verify and accepted-state recovery for Qwen GDN.
+
+Port of the Kimi-K3 KDA RecoverSSM path to the gated delta rule used by
+Qwen3.5 / Qwen3-Next. The verify kernel runs the whole k+1 window off the
+committed checkpoint without writing any state; it records, per token, the
+beta-scaled delta-rule correction (fp32, per value head) plus the raw key and
+raw gate input (activation dtype, lossless). After sampling, the commit folds
+the accepted prefix into the checkpoint with a single state write:
+
+    S_n = (prod_i exp(g_i)) S_0 + sum_i (prod_{j>i} exp(g_j)) c_i k_i^T
+
+GDN differences from KDA: the gate is one scalar per value head
+(g = -exp(A_log) * softplus(a + dt_bias)), q/k heads are shared by
+num_v_heads // num_k_heads value heads, and q/k/v arrive packed post-conv.
+"""
+
+import os
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+
+from vllm.model_executor.layers.mamba.mamba_utils import is_conv_state_dim_first
+from vllm.models.kimi_k3.nvidia.ops.recoverssm import _compact_conv_state_kernel
+from vllm.triton_utils import tl, triton
+from vllm.v1.attention.backends.utils import NULL_BLOCK_ID
+
+_DEBUG = bool(os.environ.get("VLLM_GDN_RECOVER_DEBUG"))
+
+
+def _debug_sync(tag: str, **info) -> None:
+    """VLLM_GDN_RECOVER_DEBUG: synchronize after each kernel so a fault is
+    attributed to the kernel that caused it."""
+    if not _DEBUG or torch.cuda.is_current_stream_capturing():
+        return
+    try:
+        torch.cuda.synchronize()
+    except Exception:
+        print(f"[gdn_recover] FAULT in {tag}: {info}", flush=True)
+        raise
+
+
+@triton.heuristics(
+    {
+        "HAS_REQUEST_INDICES": lambda args: args["request_indices_ptr"] is not None,
+        "ALIGN_MODE": lambda args: args["block_table_ptr"] is not None,
+    }
+)
+@triton.jit
+def _prepare_commit_plan_kernel(
+    num_accepted_ptr,
+    request_indices_ptr,
+    state_indices_ptr,
+    query_start_loc_ptr,
+    block_table_ptr,
+    num_computed_ptr,
+    commit_lens_ptr,
+    final_state_indices_ptr,
+    boundary_state_indices_ptr,
+    boundary_recovery_lens_ptr,
+    null_block_id,
+    mamba_block_size,
+    block_table_width,
+    stride_num_accepted,
+    stride_request_indices,
+    stride_state_indices,
+    stride_query_start_loc,
+    stride_block_table_row,
+    stride_block_table_col,
+    stride_num_computed,
+    SPEC_QUERY_LEN: tl.constexpr,
+    HAS_REQUEST_INDICES: tl.constexpr,
+    ALIGN_MODE: tl.constexpr,
+):
+    """Same as the KDA plan, except that in align mode the final state goes to
+    the block holding the last committed token ((n - 1) // block_size, the
+    align-mode running-state convention). n // block_size is the block of the
+    *next* token, which is not allocated yet when n lands exactly on a block
+    boundary; its block-table entry is stale and may belong to another
+    request."""
+    spec_idx = tl.program_id(0)
+    source_state_idx = tl.load(state_indices_ptr + spec_idx * stride_state_indices).to(
+        tl.int64
+    )
+    request_idx = spec_idx
+    if HAS_REQUEST_INDICES:
+        request_idx = tl.load(
+            request_indices_ptr + spec_idx * stride_request_indices
+        ).to(tl.int64)
+    num_accepted = tl.load(num_accepted_ptr + request_idx * stride_num_accepted).to(
+        tl.int32
+    )
+    bos = tl.load(query_start_loc_ptr + spec_idx * stride_query_start_loc).to(tl.int64)
+    eos = tl.load(query_start_loc_ptr + (spec_idx + 1) * stride_query_start_loc).to(
+        tl.int64
+    )
+    query_len = (eos - bos).to(tl.int32)
+    commit_len = tl.minimum(tl.maximum(num_accepted, 0), query_len)
+    commit_len = tl.minimum(commit_len, SPEC_QUERY_LEN)
+
+    final_state_idx = source_state_idx
+    boundary_state_idx = null_block_id
+    boundary_recovery_len = 0
+    if ALIGN_MODE:
+        num_computed = tl.load(num_computed_ptr + request_idx * stride_num_computed).to(
+            tl.int32
+        )
+        final_num_computed = num_computed + commit_len
+        final_state_col = tl.minimum(
+            (tl.maximum(final_num_computed, 1) - 1) // mamba_block_size,
+            block_table_width - 1,
+        )
+        final_state_idx = tl.load(
+            block_table_ptr
+            + request_idx * stride_block_table_row
+            + final_state_col * stride_block_table_col
+        ).to(tl.int64)
+        next_boundary = (num_computed // mamba_block_size + 1) * mamba_block_size
+        crosses_boundary = final_num_computed >= next_boundary
+        boundary_recovery_len = next_boundary - num_computed
+        boundary_state_idx = tl.load(
+            block_table_ptr
+            + request_idx * stride_block_table_row
+            + (next_boundary // mamba_block_size - 1) * stride_block_table_col,
+            mask=crosses_boundary,
+            other=null_block_id,
+        ).to(tl.int64)
+    valid = (source_state_idx > null_block_id) & (commit_len > 0)
+    tl.store(commit_lens_ptr + spec_idx, tl.where(valid, commit_len, 0))
+    tl.store(
+        final_state_indices_ptr + spec_idx,
+        tl.where(valid, final_state_idx, null_block_id),
+    )
+    tl.store(
+        boundary_state_indices_ptr + spec_idx,
+        tl.where(valid, boundary_state_idx, null_block_id),
+    )
+    tl.store(
+        boundary_recovery_lens_ptr + spec_idx,
+        tl.where(valid, boundary_recovery_len, 0),
+    )
+
+
+@triton.jit
+def _gdn_log_decay(raw_a, dt_bias, A):
+    x = raw_a + dt_bias
+    softplus = tl.where(x <= 20.0, tl.log(1.0 + tl.exp(x)), x)
+    return -A * softplus
+
+
+@triton.jit
+def _gdn_recoverssm_verify_kernel(
+    qkv_ptr,
+    a_ptr,
+    b_ptr,
+    A_log_ptr,
+    dt_bias_ptr,
+    state_ptr,
+    correction_cache_ptr,
+    kg_cache_ptr,
+    out_ptr,
+    query_start_loc_ptr,
+    state_indices_ptr,
+    null_block_id,
+    scale,
+    stride_qkv_token,
+    stride_a_token,
+    stride_b_token,
+    stride_state_block,
+    stride_state_head,
+    stride_state_v,
+    stride_state_k,
+    stride_correction_block,
+    stride_correction_head,
+    stride_correction_pos,
+    stride_kg_block,
+    stride_kg_head,
+    stride_kg_pos,
+    stride_out_token,
+    stride_out_head,
+    HK: tl.constexpr,
+    HV: tl.constexpr,
+    K: tl.constexpr,
+    V: tl.constexpr,
+    BK: tl.constexpr,
+    BV: tl.constexpr,
+    SPEC_QUERY_LEN: tl.constexpr,
+):
+    pid_v = tl.program_id(0)
+    pid_b = tl.program_id(1)
+    pid_h = tl.program_id(2)
+    pid_hk = pid_h // (HV // HK)
+
+    bos = tl.load(query_start_loc_ptr + pid_b).to(tl.int64)
+    eos = tl.load(query_start_loc_ptr + pid_b + 1).to(tl.int64)
+    query_len = eos - bos
+    state_idx = tl.load(state_indices_ptr + pid_b).to(tl.int64)
+
+    offs_k = tl.arange(0, BK)
+    offs_v = pid_v * BV + tl.arange(0, BV)
+    mask_k = offs_k < K
+    mask_v = offs_v < V
+    mask_state = mask_v[:, None] & mask_k[None, :]
+
+    if state_idx <= null_block_id:
+        for t in tl.static_range(SPEC_QUERY_LEN):
+            tl.store(
+                out_ptr + (bos + t) * stride_out_token + pid_h * stride_out_head + offs_v,
+                tl.zeros([BV], dtype=tl.float32),
+                mask=(t < query_len) & mask_v,
+            )
+        return
+
+    state = tl.load(
+        state_ptr
+        + state_idx * stride_state_block
+        + pid_h * stride_state_head
+        + offs_v[:, None] * stride_state_v
+        + offs_k[None, :] * stride_state_k,
+        mask=mask_state,
+        other=0.0,
+    ).to(tl.float32)
+    A = tl.exp(tl.load(A_log_ptr + pid_h).to(tl.float32))
+    dt_bias = tl.load(dt_bias_ptr + pid_h).to(tl.float32)
+
+    q_off = pid_hk * K
+    k_off = HK * K + pid_hk * K
+    v_off = 2 * HK * K + pid_h * V
+    # Records are per spec-decode row; commit reads them back by the same row.
+    row_idx = pid_b.to(tl.int64)
+    correction_base = (
+        correction_cache_ptr
+        + row_idx * stride_correction_block
+        + pid_h * stride_correction_head
+    )
+    kg_base = kg_cache_ptr + row_idx * stride_kg_block + pid_h * stride_kg_head
+
+    for t in tl.static_range(SPEC_QUERY_LEN):
+        valid = t < query_len
+        token = bos + t
+        row = qkv_ptr + token * stride_qkv_token
+        q = tl.load(row + q_off + offs_k, mask=valid & mask_k, other=0.0).to(
+            tl.float32
+        )
+        k_raw = tl.load(row + k_off + offs_k, mask=valid & mask_k, other=0.0)
+        v = tl.load(row + v_off + offs_v, mask=valid & mask_v, other=0.0).to(
+            tl.float32
+        )
+        raw_a = tl.load(a_ptr + token * stride_a_token + pid_h, mask=valid, other=0.0)
+        raw_b = tl.load(b_ptr + token * stride_b_token + pid_h, mask=valid, other=0.0)
+
+        k = k_raw.to(tl.float32)
+        k = k / tl.sqrt(tl.sum(k * k) + 1e-6)
+        q = q / tl.sqrt(tl.sum(q * q) + 1e-6) * scale
+        decay = tl.exp(_gdn_log_decay(raw_a.to(tl.float32), dt_bias, A))
+        beta = tl.sigmoid(raw_b.to(tl.float32))
+
+        new_state = state * decay
+        correction = (v - tl.sum(new_state * k[None, :], axis=1)) * beta
+        new_state += correction[:, None] * k[None, :]
+        state = tl.where(valid, new_state, state)
+
+        out = tl.sum(state * q[None, :], axis=1)
+        tl.store(
+            out_ptr + token * stride_out_token + pid_h * stride_out_head + offs_v,
+            out.to(out_ptr.dtype.element_ty),
+            mask=valid & mask_v,
+        )
+        tl.store(
+            correction_base + t * stride_correction_pos + offs_v,
+            correction,
+            mask=valid & mask_v,
+        )
+        if pid_v == 0:
+            tl.store(kg_base + t * stride_kg_pos + offs_k, k_raw, mask=valid & mask_k)
+            tl.store(kg_base + t * stride_kg_pos + K, raw_a, mask=valid)
+
+
+@triton.jit
+def _commit_gdn_state_kernel(
+    state_ref_ptr,
+    state_base_addrs_ptr,
+    state_block_strides_ptr,
+    correction_cache_ref_ptr,
+    correction_cache_base_addrs_ptr,
+    correction_cache_block_strides_ptr,
+    kg_cache_ref_ptr,
+    kg_cache_base_addrs_ptr,
+    kg_cache_block_strides_ptr,
+    A_log_ptr,
+    dt_bias_ptr,
+    state_indices_ptr,
+    commit_lens_ptr,
+    final_state_indices_ptr,
+    boundary_state_indices_ptr,
+    boundary_recovery_lens_ptr,
+    null_block_id,
+    stride_state_head,
+    stride_state_v,
+    stride_state_k,
+    stride_correction_head,
+    stride_correction_pos,
+    stride_kg_head,
+    stride_kg_pos,
+    stride_state_indices,
+    K: tl.constexpr,
+    V: tl.constexpr,
+    BK: tl.constexpr,
+    BV: tl.constexpr,
+    NUM_HEADS: tl.constexpr,
+    ALIGN_MODE: tl.constexpr,
+):
+    pid_v = tl.program_id(0)
+    pid_b = tl.program_id(1)
+    pid_lh = tl.program_id(2)
+    pid_l = pid_lh // NUM_HEADS
+    pid_h = pid_lh % NUM_HEADS
+
+    source_idx = tl.load(state_indices_ptr + pid_b * stride_state_indices).to(tl.int64)
+    if source_idx <= null_block_id:
+        return
+    commit_len = tl.load(commit_lens_ptr + pid_b)
+    if commit_len == 0:
+        return
+    final_idx = tl.load(final_state_indices_ptr + pid_b).to(tl.int64)
+    boundary_idx = tl.load(boundary_state_indices_ptr + pid_b).to(tl.int64)
+    boundary_len = tl.load(boundary_recovery_lens_ptr + pid_b)
+    if final_idx <= null_block_id:
+        return
+
+    state_ptr = tl.load(state_base_addrs_ptr + pid_l).to(
+        tl.pointer_type(state_ref_ptr.dtype.element_ty)
+    )
+    state_block_stride = tl.load(state_block_strides_ptr + pid_l)
+    correction_ptr = tl.load(correction_cache_base_addrs_ptr + pid_l).to(
+        tl.pointer_type(correction_cache_ref_ptr.dtype.element_ty)
+    )
+    correction_ptr += (
+        pid_b.to(tl.int64) * tl.load(correction_cache_block_strides_ptr + pid_l)
+        + pid_h * stride_correction_head
+    )
+    kg_ptr = tl.load(kg_cache_base_addrs_ptr + pid_l).to(
+        tl.pointer_type(kg_cache_ref_ptr.dtype.element_ty)
+    )
+    kg_ptr += (
+        pid_b.to(tl.int64) * tl.load(kg_cache_block_strides_ptr + pid_l)
+        + pid_h * stride_kg_head
+    )
+
+    offs_k = tl.arange(0, BK)
+    offs_v = pid_v * BV + tl.arange(0, BV)
+    mask_k = offs_k < K
+    mask_v = offs_v < V
+    mask_state = mask_v[:, None] & mask_k[None, :]
+    head_offs = (
+        pid_h * stride_state_head
+        + offs_v[:, None] * stride_state_v
+        + offs_k[None, :] * stride_state_k
+    )
+    initial_state = tl.load(
+        state_ptr + source_idx * state_block_stride + head_offs,
+        mask=mask_state,
+        other=0.0,
+    ).to(tl.float32)
+    A = tl.exp(tl.load(A_log_ptr + pid_l * NUM_HEADS + pid_h).to(tl.float32))
+    dt_bias = tl.load(dt_bias_ptr + pid_l * NUM_HEADS + pid_h).to(tl.float32)
+
+    # Walk the accepted tokens backwards so each update is scaled by the decay
+    # of the tokens after it.
+    final_decay = 1.0
+    final_update = tl.zeros([BV, BK], tl.float32)
+    boundary_decay = 1.0
+    boundary_update = tl.zeros([BV, BK], tl.float32)
+    for r in range(commit_len):
+        t = commit_len - r - 1
+        k = tl.load(kg_ptr + t * stride_kg_pos + offs_k, mask=mask_k, other=0.0).to(
+            tl.float32
+        )
+        raw_a = tl.load(kg_ptr + t * stride_kg_pos + K).to(tl.float32)
+        correction = tl.load(
+            correction_ptr + t * stride_correction_pos + offs_v,
+            mask=mask_v,
+            other=0.0,
+        )
+        k = k / tl.sqrt(tl.sum(k * k) + 1e-6)
+        update = correction[:, None] * k[None, :]
+        decay = tl.exp(_gdn_log_decay(raw_a, dt_bias, A))
+        final_update += update * final_decay
+        final_decay *= decay
+        if ALIGN_MODE:
+            before = t < boundary_len
+            boundary_update += tl.where(before, update * boundary_decay, 0.0)
+            boundary_decay *= tl.where(before, decay, 1.0)
+
+    if ALIGN_MODE:
+        tl.store(
+            state_ptr + boundary_idx * state_block_stride + head_offs,
+            initial_state * boundary_decay + boundary_update,
+            mask=mask_state & (boundary_idx > null_block_id),
+        )
+    tl.store(
+        state_ptr + final_idx * state_block_stride + head_offs,
+        initial_state * final_decay + final_update,
+        mask=mask_state,
+    )
+
+
+def gdn_recoverssm_verify(
+    mixed_qkv: torch.Tensor,
+    a: torch.Tensor,
+    b: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    checkpoint_state: torch.Tensor,
+    correction_cache: torch.Tensor,
+    kg_cache: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    state_indices: torch.Tensor,
+    out: torch.Tensor,
+    num_k_heads: int,
+    head_k_dim: int,
+    spec_query_len: int,
+    scale: float,
+) -> torch.Tensor:
+    """Verify a GDN speculative window without modifying its checkpoint.
+
+    mixed_qkv: [tokens, 2 * HK * K + HV * V] post-conv packed q|k|v
+    a, b:      [tokens, HV] raw gate / beta inputs
+    out:       [tokens, HV, V]
+    """
+    num_blocks, num_v_heads, value_dim, key_dim = checkpoint_state.shape
+    assert key_dim == head_k_dim
+    assert mixed_qkv.stride(-1) == 1 and a.stride(-1) == 1 and b.stride(-1) == 1
+    assert mixed_qkv.shape[-1] == 2 * num_k_heads * key_dim + num_v_heads * value_dim
+    assert correction_cache.shape[1:] == (num_v_heads, spec_query_len, value_dim)
+    assert correction_cache.dtype == torch.float32
+    assert kg_cache.shape[1:] == (num_v_heads, spec_query_len, key_dim + 1)
+    assert out.shape[1:] == (num_v_heads, value_dim) and out.stride(-1) == 1
+    batch = state_indices.shape[0]
+    assert query_start_loc.shape[0] == batch + 1
+    assert batch <= correction_cache.shape[0] and batch <= kg_cache.shape[0]
+    if mixed_qkv.shape[0] == 0 or batch == 0:
+        return out
+
+    # Tuned on L40S at 29 rows x 32 heads x 128^2 (benchmarks/kernels/
+    # bench_gdn_recoverssm.py): narrow tiles, one warp.
+    block_v = min(triton.next_power_of_2(value_dim), 16)
+    grid = (triton.cdiv(value_dim, block_v), batch, num_v_heads)
+    _gdn_recoverssm_verify_kernel[grid](
+        mixed_qkv,
+        a,
+        b,
+        A_log,
+        dt_bias,
+        checkpoint_state,
+        correction_cache,
+        kg_cache,
+        out,
+        query_start_loc,
+        state_indices,
+        NULL_BLOCK_ID,
+        scale,
+        mixed_qkv.stride(0),
+        a.stride(0),
+        b.stride(0),
+        checkpoint_state.stride(0),
+        checkpoint_state.stride(1),
+        checkpoint_state.stride(2),
+        checkpoint_state.stride(3),
+        correction_cache.stride(0),
+        correction_cache.stride(1),
+        correction_cache.stride(2),
+        kg_cache.stride(0),
+        kg_cache.stride(1),
+        kg_cache.stride(2),
+        out.stride(0),
+        out.stride(1),
+        HK=num_k_heads,
+        HV=num_v_heads,
+        K=key_dim,
+        V=value_dim,
+        BK=triton.next_power_of_2(key_dim),
+        BV=block_v,
+        SPEC_QUERY_LEN=spec_query_len,
+        num_warps=1,
+        num_stages=2,
+    )
+    _debug_sync("verify", batch=batch, tokens=mixed_qkv.shape[0])
+    return out
+
+
+@dataclass
+class GDNRecoverSSMCommitContext:
+    """Per-KV-group commit state: raw pointers to every layer's caches so one
+    launch folds the accepted tokens into all layers of the group."""
+
+    conv_ref: torch.Tensor
+    conv_state_base_addrs: torch.Tensor
+    conv_state_block_strides: torch.Tensor
+    conv_state_dim_strides: torch.Tensor
+    conv_state_token_strides: torch.Tensor
+    conv_history_len: int
+    state_ref: torch.Tensor
+    state_base_addrs: torch.Tensor
+    state_block_strides: torch.Tensor
+    correction_ref: torch.Tensor
+    correction_base_addrs: torch.Tensor
+    correction_block_strides: torch.Tensor
+    kg_ref: torch.Tensor
+    kg_base_addrs: torch.Tensor
+    kg_block_strides: torch.Tensor
+    num_layers: int
+    commit_lens: torch.Tensor
+    final_state_indices: torch.Tensor
+    boundary_state_indices: torch.Tensor
+    boundary_recovery_lens: torch.Tensor
+    A_log: torch.Tensor
+    dt_bias: torch.Tensor
+    spec_query_len: int
+
+    @classmethod
+    def create(
+        cls, layers: Sequence[Any], *, spec_query_len: int, max_num_reqs: int
+    ) -> "GDNRecoverSSMCommitContext":
+        assert layers
+        assert all(hasattr(layer, "recoverssm_correction") for layer in layers), (
+            "GDN RecoverSSM layers must own per-row correction/key-gate records"
+        )
+        conv_states = [layer.kv_cache[0] for layer in layers]
+        if not is_conv_state_dim_first():
+            conv_states = [s.transpose(-1, -2) for s in conv_states]
+        states = [layer.kv_cache[1] for layer in layers]
+        corrections = [layer.recoverssm_correction for layer in layers]
+        kgs = [layer.recoverssm_kg for layer in layers]
+        for group in (conv_states, states, corrections, kgs):
+            ref = group[0]
+            assert all(
+                t.shape == ref.shape
+                and t.dtype == ref.dtype
+                and t.stride()[1:] == ref.stride()[1:]
+                for t in group
+            ), "GDN RecoverSSM layers need matching cache layouts"
+        conv_history_len = conv_states[0].shape[2] - spec_query_len + 1
+        assert conv_history_len > 0
+        device = states[0].device
+
+        def _i64(values):
+            return torch.tensor(values, dtype=torch.int64, device=device)
+
