diff --git a/benchmarks/kernels/bench_gdn_recoverssm.py b/benchmarks/kernels/bench_gdn_recoverssm.py
new file mode 100644
index 000000000..b455f1fca
--- /dev/null
+++ b/benchmarks/kernels/bench_gdn_recoverssm.py
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Tile sweep for the GDN RecoverSSM verify / commit kernels at a Qwen3.5-4B
+decode shape (29 spec rows, 32 value heads, K=V=128, window 6, 24 layers)."""
+
+import itertools
+
+import torch
+
+from vllm.model_executor.layers.mamba.ops.gdn_recoverssm import (
+    NULL_BLOCK_ID,
+    _commit_gdn_state_kernel,
+    _gdn_recoverssm_verify_kernel,
+)
+from vllm.triton_utils import triton
+
+dev = "cuda"
+HK, HV, K, V, L, B, LAYERS = 16, 32, 128, 128, 6, 29, 24
+nblk = 4 * B + 1
+T = B * L
+torch.manual_seed(0)
+mixed = torch.randn(T, 2 * HK * K + HV * V, device=dev, dtype=torch.bfloat16)
+a = torch.randn(T, HV, device=dev, dtype=torch.bfloat16)
+b = torch.randn(T, HV, device=dev, dtype=torch.bfloat16)
+A_log = torch.randn(HV, device=dev) * 0.5
+dt_bias = torch.randn(HV, device=dev) * 0.5
+qsl = torch.arange(0, T + 1, L, device=dev, dtype=torch.int32)
+src = torch.arange(1, B + 1, device=dev, dtype=torch.int32)
+states = [
+    (torch.randn(nblk, HV, V, K, device=dev) * 0.1).to(torch.bfloat16)
+    for _ in range(LAYERS)
+]
+corrs = [torch.randn(B, HV, L, V, device=dev) for _ in range(LAYERS)]
+kgs = [torch.randn(B, HV, L, K + 1, device=dev, dtype=torch.bfloat16) for _ in range(LAYERS)]
+out = torch.empty(T, HV, V, device=dev, dtype=torch.bfloat16)
+
+
+def i64(xs):
+    return torch.tensor(xs, dtype=torch.int64, device=dev)
+
+
+def verify(bv, warps, stages):
+    for layer in range(LAYERS):
+        st, c, kg = states[layer], corrs[layer], kgs[layer]
+        _gdn_recoverssm_verify_kernel[(triton.cdiv(V, bv), B, HV)](
+            mixed, a, b, A_log, dt_bias, st, c, kg, out, qsl, src, NULL_BLOCK_ID,
+            K**-0.5, mixed.stride(0), a.stride(0), b.stride(0),
+            *st.stride(), *c.stride()[:3], *kg.stride()[:3], out.stride(0),
+            out.stride(1), HK=HK, HV=HV, K=K, V=V, BK=K, BV=bv,
+            SPEC_QUERY_LEN=L, num_warps=warps, num_stages=stages,
+        )
+
+
+commit_lens = torch.randint(1, L + 1, (B,), device=dev, dtype=torch.int32)
+final = torch.arange(B + 1, 2 * B + 1, device=dev, dtype=torch.int32)
+dummy = torch.zeros(B, device=dev, dtype=torch.int32)
+st_addrs = i64([t.data_ptr() for t in states])
+st_strides = i64([t.stride(0) for t in states])
+c_addrs = i64([t.data_ptr() for t in corrs])
+c_strides = i64([t.stride(0) for t in corrs])
+kg_addrs = i64([t.data_ptr() for t in kgs])
+kg_strides = i64([t.stride(0) for t in kgs])
+A_all = A_log[None].expand(LAYERS, HV).contiguous()
+dt_all = dt_bias[None].expand(LAYERS, HV).contiguous()
+
+
+def commit(bv, warps, stages):
+    st, c, kg = states[0], corrs[0], kgs[0]
+    _commit_gdn_state_kernel[(triton.cdiv(V, bv), B, LAYERS * HV)](
+        st, st_addrs, st_strides, c, c_addrs, c_strides, kg, kg_addrs, kg_strides,
+        A_all, dt_all, src, commit_lens, final, dummy, dummy, NULL_BLOCK_ID,
+        st.stride(1), st.stride(2), st.stride(3), c.stride(1), c.stride(2),
+        kg.stride(1), kg.stride(2), 1, K=K, V=V, BK=K, BV=bv, NUM_HEADS=HV,
+        ALIGN_MODE=False, num_warps=warps, num_stages=stages,
+    )
+
+
+def timeit(fn):
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        fn()
+    start, end = torch.cuda.Event(True), torch.cuda.Event(True)
+    start.record()
+    for _ in range(20):
+        g.replay()
+    end.record()
+    torch.cuda.synchronize()
+    return start.elapsed_time(end) / 20
+
+
+for name, fn in (("verify", verify), ("commit", commit)):
+    res = []
+    for bv, warps, stages in itertools.product((16, 32, 64), (1, 2, 4, 8), (1, 2, 3)):
+        try:
+            res.append((timeit(lambda: fn(bv, warps, stages)), bv, warps, stages))
+        except Exception as e:  # noqa: BLE001
+            res.append((float("inf"), bv, warps, stages))
+    res.sort()
+    cur = [r for r in res if r[1:] == (32, 4, 2)][0]
+    print(f"{name}: current BV=32 w=4 s=2 {cur[0]:.3f} ms (24 layers)")
+    for r in res[:5]:
+        print(f"  {r[0]:.3f} ms  BV={r[1]} warps={r[2]} stages={r[3]}")
diff --git a/tests/kernels/test_gdn_recoverssm.py b/tests/kernels/test_gdn_recoverssm.py
new file mode 100644
index 000000000..be5c792c7
--- /dev/null
+++ b/tests/kernels/test_gdn_recoverssm.py
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN RecoverSSM verify + commit vs the baseline spec kernel, which writes
+one state per draft position."""
+
+import pytest
+import torch
+
+from vllm.third_party.flash_linear_attention.ops import (
+    fused_sigmoid_gating_delta_rule_update,
+)
+from vllm.model_executor.layers.mamba.ops.gdn_recoverssm import (
+    _commit_gdn_state_kernel,
+    gdn_recoverssm_verify,
+)
+from vllm.triton_utils import triton
+
+
+@pytest.mark.parametrize("state_dtype", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("num_spec", [3, 5])
+def test_gdn_recoverssm_matches_baseline(state_dtype, num_spec):
+    torch.manual_seed(0)
+    dev = "cuda"
+    HK, HV, K, V = 16, 32, 128, 128
+    L = num_spec + 1
+    batch, nblk = 7, 64
+    qlens = torch.tensor([L, 1, L, 3, L, 2, L])
+    qsl = torch.zeros(batch + 1, dtype=torch.int32)
+    qsl[1:] = qlens.cumsum(0)
+    T = int(qsl[-1])
+    qsl = qsl.to(dev)
+
+    mixed = torch.randn(T, 2 * HK * K + HV * V, device=dev, dtype=torch.bfloat16)
+    a = torch.randn(T, HV, device=dev, dtype=torch.bfloat16)
+    b = torch.randn(T, HV, device=dev, dtype=torch.bfloat16)
+    A_log = torch.randn(HV, device=dev, dtype=torch.float32) * 0.5
+    dt_bias = torch.randn(HV, device=dev, dtype=torch.float32) * 0.5
+    blocks = torch.randperm(nblk - 1, device=dev)[: batch * L].view(batch, L) + 1
+    blocks = blocks.to(torch.int32)
+    state0 = (torch.randn(nblk, HV, V, K, device=dev) * 0.1).to(state_dtype)
+
+    # baseline: one state slot per token position
+    q, k, v = mixed.split([HK * K, HK * K, HV * V], dim=-1)
+    q = q.reshape(1, T, HK, K)
+    k = k.reshape(1, T, HK, K)
+    v = v.reshape(1, T, HV, V)
+    ref_state = state0.clone()
+    ref_out, _ = fused_sigmoid_gating_delta_rule_update(
+        A_log=A_log, a=a, b=b, dt_bias=dt_bias, q=q, k=k, v=v,
+        initial_state=ref_state, inplace_final_state=True, cu_seqlens=qsl,
+        ssm_state_indices=blocks,
+        num_accepted_tokens=torch.ones(batch, dtype=torch.int32, device=dev),
+        use_qk_l2norm_in_kernel=True,
+    )
+
+    # RecoverSSM: verify off the checkpoint (slot 0), then commit
+    state = state0.clone()
+    corr = torch.zeros(batch, HV, L, V, device=dev, dtype=torch.float32)
+    kg = torch.zeros(batch, HV, L, K + 1, device=dev, dtype=torch.bfloat16)
+    out = torch.empty(T, HV, V, device=dev, dtype=torch.bfloat16)
+    src = blocks[:, 0].contiguous()
+    gdn_recoverssm_verify(
+        mixed, a, b, A_log, dt_bias, state, corr, kg, qsl, src, out,
+        num_k_heads=HK, head_k_dim=K, spec_query_len=L, scale=K**-0.5,
+    )
+    assert torch.equal(state, state0), "verify must not write the checkpoint"
+    torch.testing.assert_close(out.float(), ref_out[0].float(), atol=2e-2, rtol=2e-2)
+
+    # commit each row with a different accepted length into a fresh block
+    commit = torch.tensor([L, 1, 2, 3, L - 1, 1, 4], dtype=torch.int32)
+    commit = torch.minimum(commit, qlens.to(torch.int32)).to(dev)
+    final = torch.arange(nblk - batch, nblk, dtype=torch.int32, device=dev)
+    dummy = torch.full((batch,), 0, dtype=torch.int32, device=dev)
+    i64 = lambda xs: torch.tensor(xs, dtype=torch.int64, device=dev)  # noqa: E731
+    BV = 32
+    _commit_gdn_state_kernel[(triton.cdiv(V, BV), batch, HV)](
+        state, i64([state.data_ptr()]), i64([state.stride(0)]),
+        corr, i64([corr.data_ptr()]), i64([corr.stride(0)]),
+        kg, i64([kg.data_ptr()]), i64([kg.stride(0)]),
+        A_log[None], dt_bias[None], src, commit, final, dummy, dummy,
+        0, state.stride(1), state.stride(2), state.stride(3),
+        corr.stride(1), corr.stride(2), kg.stride(1), kg.stride(2), 1,
+        K=K, V=V, BK=K, BV=BV, NUM_HEADS=HV, ALIGN_MODE=False,
+        num_warps=4, num_stages=2,
+    )
+    for i in range(batch):
+        n = int(commit[i])
+        expect = ref_state[blocks[i, n - 1]].float()
+        got = state[final[i]].float()
+        tol = 1e-4 if state_dtype == torch.float32 else 2e-2
+        torch.testing.assert_close(got, expect, atol=tol, rtol=tol)
