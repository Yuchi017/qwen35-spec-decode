+
+    # vLLM-style cumulative acceptance per draft slot: slot k counts only when
+    # slots 1..k are all correct (spec_decode_num_accepted_tokens_per_pos / drafts),
+    # unlike position_{k}_acc, which scores each slot on its own.
+    correct_blocks = (pred_ids == target_ids).reshape(-1, block_size)[:, start_pos:]
+    valid_blocks = loss_mask.to(torch.bool).reshape(-1, block_size)[:, start_pos:]
+    run = torch.logical_and(correct_blocks, valid_blocks).to(torch.float32).cumprod(dim=-1)
+    block_valid = valid_blocks.any(dim=-1).to(torch.float32)
+    for k in range(run.shape[-1]):
+        metrics[f"accept_pos_{k + 1}_sum"] = (run[:, k] * block_valid).sum()
+        metrics[f"accept_pos_{k + 1}_total"] = block_valid.sum()
     return loss, metrics
